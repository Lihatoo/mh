    if [[ -z "${1:-}"  ]]; then
        tun_status
        show_runtime_routing_status
        proxy_env_status
        speedtest_now 1000 || true
        # print_mihomo_status
        exit 0
    fi
  case "${1:-}" in
    add)
        cfg_add "$@";;
    start)
        [[ -n "${2:-}" ]] || die "usage: $0 start <name>"
        select_one "select" "${2}";;
    end)
        start_end "$@";;
    select)
        select_one "$@";;
    db)
        debug_one "$@";;
    doctor)
        doctor ;;
    env)
        show_proxy_exports ;;
    mode)
        shift; mode_set "${1:-}" ;;
    rules)
        shift; rules_cmd "${1:-show}" ;;
    help|-h|--help) help ;;
    -l|--list|list) list_nodes ;;
    tun) shift; tun "${1:-toggle}" ;;
    *) pick_switch_with_delay "${1:-}" 1200 ;;
  esac
}
main "$@"
